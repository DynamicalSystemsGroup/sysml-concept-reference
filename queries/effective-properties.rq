PREFIX inv: <https://github.com/DynamicalSystemsGroup/sysml-concept-reference/vocab#>
PREFIX sysml: <https://github.com/DynamicalSystemsGroup/sysml-concept-reference/id/SysML/20250201/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dct: <http://purl.org/dc/terms/>
SELECT ?property ?name ?meaning ?owner ?type ?lower ?upper ?defaultStatus ?declaredDefault ?source WHERE {
  VALUES ?concept { sysml:Systems-Parts-PartUsage }
  ?concept inv:effectiveProperty ?property .
  ?property rdfs:label ?name ; dct:description ?meaning ; inv:declaredOn ?owner ;
    inv:valueType ?type ; inv:lowerBound ?lower ; inv:upperBound ?upper ;
    inv:defaultStatus ?defaultStatus ; dct:source ?source .
  OPTIONAL { ?property inv:declaredDefault ?declaredDefault }
} ORDER BY ?name ?owner
