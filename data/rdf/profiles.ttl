<https://github.com/DynamicalSystemsGroup/sysml-concept-reference/id/profile/part-definition>
    dct:description "Defines a reusable kind of system or system part, including features that usages of that kind can have." ;
    rdf:type inv:ConceptProfile ;
    inv:caveat "Instance-level composition is governed by usages and their context, rather than by the outline of the definition box." ;
    inv:concept <https://github.com/DynamicalSystemsGroup/sysml-concept-reference/id/SysML/20250201/Systems-Parts-PartDefinition> ;
    inv:evidence <https://www.omg.org/spec/SysML/2.0/Language/PDF#page=321>, <https://www.omg.org/spec/SysML/2.0/Language/PDF#page=90> ;
    inv:evidenceStatus inv:EditorialSummary ;
    inv:hasExample <https://github.com/DynamicalSystemsGroup/sysml-concept-reference/id/example/part-definition> ;
    inv:hasNotation <https://github.com/DynamicalSystemsGroup/sysml-concept-reference/id/notation/part-definition-node> ;
    inv:hasRelationship <https://github.com/DynamicalSystemsGroup/sysml-concept-reference/id/profile/part-definition/relationship/1>, <https://github.com/DynamicalSystemsGroup/sysml-concept-reference/id/profile/part-definition/relationship/2> ;
    inv:learningPoint "A definition is a classifier; a part usage is a feature in context. They retain different metaclass identities.", "Declaring a nested definition introduces a scoped kind. It does not by itself declare a part usage.", "Properties of this metaclass describe the language definition, rather than arbitrary attributes such as a modeled wheel diameter." ;
    inv:profilePage "concepts/part-definition.md" ;
    inv:profileStatus inv:DraftSourceChecked .

