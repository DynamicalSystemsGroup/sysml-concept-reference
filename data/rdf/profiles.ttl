<https://github.com/DynamicalSystemsGroup/sysml-concept-reference/id/profile/connection-usage>
    dct:description "Represents a structural connection with end features. It combines PartUsage and ConnectorAsUsage semantics and retains its own model-element identity." ;
    rdf:type inv:ConceptProfile ;
    inv:caveat "This profile illustrates selected structural notations and does not implement execution or all association-structure semantics." ;
    inv:concept <https://github.com/DynamicalSystemsGroup/sysml-concept-reference/id/SysML/20250201/Systems-Connections-ConnectionUsage> ;
    inv:evidence <https://www.omg.org/spec/SysML/2.0/Language/PDF#page=100>, <https://www.omg.org/spec/SysML/2.0/Language/PDF#page=330> ;
    inv:evidenceStatus inv:EditorialSummary ;
    inv:hasExample <https://github.com/DynamicalSystemsGroup/sysml-concept-reference/id/example/connection-usage> ;
    inv:hasNotation <https://github.com/DynamicalSystemsGroup/sysml-concept-reference/id/notation/connection-edge-node>, <https://github.com/DynamicalSystemsGroup/sysml-concept-reference/id/notation/connection-nary> ;
    inv:hasRelationship <https://github.com/DynamicalSystemsGroup/sysml-concept-reference/id/profile/connection-usage/relationship/1>, <https://github.com/DynamicalSystemsGroup/sysml-concept-reference/id/profile/connection-usage/relationship/2> ;
    inv:learningPoint "A connection is a model element with end roles and references, even when drawn as a simple line.", "A structural connection is not interchangeable with a binding, succession or flow.", "Allowed typing includes connection definitions and suitable KerML association structures.", "Nonabstract connections require at least two ends. Each end is referential with multiplicity 1..1; cross multiplicity is a separate concept." ;
    inv:profilePage "concepts/connection-usage.md" ;
    inv:profileStatus inv:DraftSourceChecked .

<https://github.com/DynamicalSystemsGroup/sysml-concept-reference/id/profile/connection-usage/relationship/1>
    dct:description "ConnectionUsage directly specializes PartUsage as well as ConnectorAsUsage." ;
    rdf:type inv:ConceptRelationship ;
    inv:condition "A connection therefore has inherited part properties, but adds connector end structure and applicable constraints." ;
    inv:evidence <https://www.omg.org/spec/SysML/2.0/Language/PDF#page=330> ;
    inv:evidenceStatus inv:EditorialSummary ;
    inv:fromConcept <https://github.com/DynamicalSystemsGroup/sysml-concept-reference/id/SysML/20250201/Systems-Connections-ConnectionUsage> ;
    inv:relationKind "specialization" ;
    inv:toConcept <https://github.com/DynamicalSystemsGroup/sysml-concept-reference/id/SysML/20250201/Systems-Parts-PartUsage> .

