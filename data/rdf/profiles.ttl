<https://github.com/DynamicalSystemsGroup/sysml-concept-reference/id/example/connection-usage>
    dct:description "link is a named binary connection. Its ends refer to axle.mount and wheel.hub. The plain solid line is an illustrative connection representation, with no flow direction implied." ;
    rdf:type inv:Example ;
    inv:code """// Original documentation example. Source-reviewed; not parser-validated.
package AssemblyExample {
    port def Mount;

    part def Wheel {
        port hub : Mount;
    }

    part def Axle {
        port mount : Mount;
    }

    part def Assembly {
        part wheel : Wheel;
        part axle : Axle;
        ref part spare : Wheel[0..1];
        connection link connect axle.mount to wheel.hub;
    }

    part assembly : Assembly;
}
""" ;
    inv:evidence <https://www.omg.org/spec/SysML/2.0/Language/PDF#page=103> ;
    inv:verificationStatus inv:SourceReviewedNotExecuted .

<https://github.com/DynamicalSystemsGroup/sysml-concept-reference/id/example/part-definition>
    dct:description "Wheel, Axle and Assembly are part definitions. Their port and part declarations specify features; assembly : Assembly is a separate usage of the defined kind." ;
    rdf:type inv:Example ;
    inv:code """// Original documentation example. Source-reviewed; not parser-validated.
package AssemblyExample {
    port def Mount;

    part def Wheel {
        port hub : Mount;
    }

    part def Axle {
        port mount : Mount;
    }

    part def Assembly {
        part wheel : Wheel;
        part axle : Axle;
        ref part spare : Wheel[0..1];
        connection link connect axle.mount to wheel.hub;
    }

    part assembly : Assembly;
}
""" ;
    inv:evidence <https://www.omg.org/spec/SysML/2.0/Language/PDF#page=93> ;
    inv:verificationStatus inv:SourceReviewedNotExecuted .

<https://github.com/DynamicalSystemsGroup/sysml-concept-reference/id/example/part-usage>
    dct:description "wheel is a composite part usage within Assembly. spare is an owned but referential part usage. Both are typed by Wheel; the [0..1] on spare explicitly constrains its modeled values." ;
    rdf:type inv:Example ;
    inv:code """// Original documentation example. Source-reviewed; not parser-validated.
package AssemblyExample {
    port def Mount;

    part def Wheel {
        port hub : Mount;
    }

    part def Axle {
        port mount : Mount;
    }

    part def Assembly {
        part wheel : Wheel;
        part axle : Axle;
        ref part spare : Wheel[0..1];
        connection link connect axle.mount to wheel.hub;
    }

    part assembly : Assembly;
}
""" ;
    inv:evidence <https://www.omg.org/spec/SysML/2.0/Language/PDF#page=72>, <https://www.omg.org/spec/SysML/2.0/Language/PDF#page=93> ;
    inv:verificationStatus inv:SourceReviewedNotExecuted .

<https://github.com/DynamicalSystemsGroup/sysml-concept-reference/id/example/port-usage>
    dct:description "hub and mount are port usages typed by Mount. The connection refers to them through axle.mount and wheel.hub. The example uses no directional arrows or transfer behavior." ;
    rdf:type inv:Example ;
    inv:code """// Original documentation example. Source-reviewed; not parser-validated.
package AssemblyExample {
    port def Mount;

    part def Wheel {
        port hub : Mount;
    }

    part def Axle {
        port mount : Mount;
    }

    part def Assembly {
        part wheel : Wheel;
        part axle : Axle;
        ref part spare : Wheel[0..1];
        connection link connect axle.mount to wheel.hub;
    }

    part assembly : Assembly;
}
""" ;
    inv:evidence <https://www.omg.org/spec/SysML/2.0/Language/PDF#page=103>, <https://www.omg.org/spec/SysML/2.0/Language/PDF#page=95> ;
    inv:verificationStatus inv:SourceReviewedNotExecuted .

