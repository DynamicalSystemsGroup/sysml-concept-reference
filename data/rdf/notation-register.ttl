<https://github.com/DynamicalSystemsGroup/sysml-concept-reference/id/notation-rule/compartments-are-views>
    dct:description "A node may have compartments. Each compartment is a view of selected members, rendered textually or graphically as specified by its grammar. Record selection and rendering separately." ;
    dct:source <https://www.omg.org/spec/SysML/2.0/Language/PDF#page=225> ;
    rdf:type inv:SharedNotationRule ;
    rdfs:label "Compartments and selection" ;
    inv:evidenceStatus inv:EditorialSummary ;
    inv:sourceArtifact <https://github.com/DynamicalSystemsGroup/sysml-concept-reference/id/source/sha256/46e6c0476a6f1f34f367d57e039d56659bff75e41d2e4b3d37ca4cadea84a83a> ;
    inv:supportingProduction <https://github.com/DynamicalSystemsGroup/sysml-concept-reference/id/graphical-production/8.2.3.6/compartment-stack/1> .

<https://github.com/DynamicalSystemsGroup/sysml-concept-reference/id/notation-rule/extension-restrictions>
    dct:description "The extended definition/usage productions have applicability notes requiring an extension keyword to name a MetadataDefinition directly or indirectly specializing the KerML SemanticMetadata metaclass. A full KerML dependency audit remains open." ;
    dct:source <https://www.omg.org/spec/SysML/2.0/Language/PDF#page=233> ;
    rdf:type inv:SharedNotationRule ;
    rdfs:label "Metadata keyword extensions" ;
    inv:evidenceStatus inv:EditorialSummary ;
    inv:sourceArtifact <https://github.com/DynamicalSystemsGroup/sysml-concept-reference/id/source/sha256/46e6c0476a6f1f34f367d57e039d56659bff75e41d2e4b3d37ca4cadea84a83a> ;
    inv:supportingProduction <https://github.com/DynamicalSystemsGroup/sysml-concept-reference/id/graphical-production/8.2.3.6/extended-def/1>, <https://github.com/DynamicalSystemsGroup/sysml-concept-reference/id/graphical-production/8.2.3.6/extended-usage/1> .

<https://github.com/DynamicalSystemsGroup/sysml-concept-reference/id/notation-rule/graph-structure>
    dct:description "Graphical views render nodes connected by edges. Definition and usage nodes may have ports or parameter connection points. These are presentation structures, not automatically model ownership." ;
    dct:source <https://www.omg.org/spec/SysML/2.0/Language/PDF#page=225> ;
    rdf:type inv:SharedNotationRule ;
    rdfs:label "Views contain nodes, edges and connection points" ;
    inv:evidenceStatus inv:EditorialSummary ;
    inv:sourceArtifact <https://github.com/DynamicalSystemsGroup/sysml-concept-reference/id/source/sha256/46e6c0476a6f1f34f367d57e039d56659bff75e41d2e4b3d37ca4cadea84a83a> .

<https://github.com/DynamicalSystemsGroup/sysml-concept-reference/id/notation-rule/layout-flexibility>
    dct:description "The graphical grammar generally constrains containment and connectivity. Elements may generally be relocated and stretched to fit their contents. A redraw layout is not a unique required coordinate system." ;
    dct:source <https://www.omg.org/spec/SysML/2.0/Language/PDF#page=226> ;
    rdf:type inv:SharedNotationRule ;
    rdfs:label "Layout and stretching" ;
    inv:evidenceStatus inv:EditorialSummary ;
    inv:sourceArtifact <https://github.com/DynamicalSystemsGroup/sysml-concept-reference/id/source/sha256/46e6c0476a6f1f34f367d57e039d56659bff75e41d2e4b3d37ca4cadea84a83a> .

<https://github.com/DynamicalSystemsGroup/sysml-concept-reference/id/notation-rule/line-routing>
    dct:description "Connecting lines may have straight or curved segments. Segments may have a semicircular jump where they overlap another connecting line." ;
    dct:source <https://www.omg.org/spec/SysML/2.0/Language/PDF#page=226> ;
    rdf:type inv:SharedNotationRule ;
    rdfs:label "Connecting lines and jumps" ;
    inv:evidenceStatus inv:EditorialSummary ;
    inv:sourceArtifact <https://github.com/DynamicalSystemsGroup/sysml-concept-reference/id/source/sha256/46e6c0476a6f1f34f367d57e039d56659bff75e41d2e4b3d37ca4cadea84a83a> .

<https://github.com/DynamicalSystemsGroup/sysml-concept-reference/id/notation-rule/names-aliases>
    dct:description "Definition and usage name productions reuse textual declarations and can append alias labels. The usage-name-with-alias production also has an optional caret. Prefix and inherited/derived marker semantics require their textual and Clause 7 evidence." ;
    dct:source <https://www.omg.org/spec/SysML/2.0/Language/PDF#page=231>, <https://www.omg.org/spec/SysML/2.0/Language/PDF#page=233> ;
    rdf:type inv:SharedNotationRule ;
    rdfs:label "Names and aliases" ;
    inv:evidenceStatus inv:EditorialSummary ;
    inv:sourceArtifact <https://github.com/DynamicalSystemsGroup/sysml-concept-reference/id/source/sha256/46e6c0476a6f1f34f367d57e039d56659bff75e41d2e4b3d37ca4cadea84a83a> ;
    inv:supportingProduction <https://github.com/DynamicalSystemsGroup/sysml-concept-reference/id/graphical-production/8.2.3.6/definition-name-with-alias/1>, <https://github.com/DynamicalSystemsGroup/sysml-concept-reference/id/graphical-production/8.2.3.6/el-prefix/1>, <https://github.com/DynamicalSystemsGroup/sysml-concept-reference/id/graphical-production/8.2.3.6/usage-name-with-alias/1> .

<https://github.com/DynamicalSystemsGroup/sysml-concept-reference/id/notation-rule/partial-productions>
    dct:description "Table 30 distinguishes complete productions from distributed partial productions. Repeated production names retain every source occurrence; the register flags reversed or spaced operators without silently repairing the source." ;
    dct:source <https://www.omg.org/spec/SysML/2.0/Language/PDF#page=225>, <https://www.omg.org/spec/SysML/2.0/Language/PDF#page=226> ;
    rdf:type inv:SharedNotationRule ;
    rdfs:label "Complete and partial productions" ;
    inv:evidenceStatus inv:EditorialSummary ;
    inv:sourceArtifact <https://github.com/DynamicalSystemsGroup/sysml-concept-reference/id/source/sha256/46e6c0476a6f1f34f367d57e039d56659bff75e41d2e4b3d37ca4cadea84a83a> .

<https://github.com/DynamicalSystemsGroup/sysml-concept-reference/id/notation-rule/standard-views>
    dct:description "Table 34 names eight standard view definitions and associates five with default-compartment grammar sections; geometry, grid and browser entries have blank default-compartment cells. View content/filter requirements are a separate dependency audit. The §8.2.3.26 note references §9.2.18 while the actual package is §9.2.20." ;
    dct:source <https://www.omg.org/spec/SysML/2.0/Language/PDF#page=225>, <https://www.omg.org/spec/SysML/2.0/Language/PDF#page=287>, <https://www.omg.org/spec/SysML/2.0/Language/PDF#page=545>, <https://www.omg.org/spec/SysML/2.0/Language/PDF#page=546> ;
    rdf:type inv:SharedNotationRule ;
    rdfs:label "Standard views and valid contents" ;
    inv:evidenceStatus inv:EditorialSummary ;
    inv:sourceArtifact <https://github.com/DynamicalSystemsGroup/sysml-concept-reference/id/source/sha256/46e6c0476a6f1f34f367d57e039d56659bff75e41d2e4b3d37ca4cadea84a83a> .

<https://github.com/DynamicalSystemsGroup/sysml-concept-reference/id/notation-rule/text-dependencies>
    dct:description "Graphical grammar symbols conventionally use lowercase names and hyphens. Mixed-case references import textual productions from §8.2.2; their dependencies must be reviewed rather than treated as new visual symbols." ;
    dct:source <https://www.omg.org/spec/SysML/2.0/Language/PDF#page=226> ;
    rdf:type inv:SharedNotationRule ;
    rdfs:label "Imported textual productions" ;
    inv:evidenceStatus inv:EditorialSummary ;
    inv:sourceArtifact <https://github.com/DynamicalSystemsGroup/sysml-concept-reference/id/source/sha256/46e6c0476a6f1f34f367d57e039d56659bff75e41d2e4b3d37ca4cadea84a83a> .

<https://github.com/DynamicalSystemsGroup/sysml-concept-reference/id/notation-rule/text-selection>
    dct:description "The source specifies graying a substring covering one element in a textual compartment. Selection highlighting is distinct from the permanent appearance of that element." ;
    dct:source <https://www.omg.org/spec/SysML/2.0/Language/PDF#page=227> ;
    rdf:type inv:SharedNotationRule ;
    rdfs:label "Selecting an element inside a textual compartment" ;
    inv:evidenceStatus inv:EditorialSummary ;
    inv:sourceArtifact <https://github.com/DynamicalSystemsGroup/sysml-concept-reference/id/source/sha256/46e6c0476a6f1f34f367d57e039d56659bff75e41d2e4b3d37ca4cadea84a83a> ;
    inv:supportingProduction <https://github.com/DynamicalSystemsGroup/sysml-concept-reference/id/graphical-production/8.2.3.2/element-inside-textual-compartment/1> .

