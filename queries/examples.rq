PREFIX inv: <https://github.com/DynamicalSystemsGroup/sysml-concept-reference/vocab#>
PREFIX dct: <http://purl.org/dc/terms/>
SELECT ?concept ?code ?explanation ?status ?evidence WHERE {
  ?profile a inv:ConceptProfile ; inv:concept ?concept ; inv:hasExample ?example .
  ?example inv:code ?code ; dct:description ?explanation ; inv:verificationStatus ?status ; inv:evidence ?evidence .
} ORDER BY ?concept
