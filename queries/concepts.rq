PREFIX inv: <https://github.com/rororowyourboat/sysmlv2_inventory/vocab#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dct: <http://purl.org/dc/terms/>
SELECT ?concept ?name ?meaning ?source WHERE {
  ?concept inv:isFocus true ; rdfs:label ?name ; dct:description ?meaning ; dct:source ?source .
} ORDER BY ?name
