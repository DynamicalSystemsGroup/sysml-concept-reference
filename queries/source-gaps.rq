PREFIX inv: <https://github.com/DynamicalSystemsGroup/sysml-concept-reference/vocab#>
PREFIX dct: <http://purl.org/dc/terms/>
# Expected to return zero rows. External UML type references are deliberately not extracted records.
SELECT ?record WHERE {
  ?record a inv:Record .
  FILTER NOT EXISTS { ?record dct:source ?source ; inv:sourceArtifact ?artifact ; inv:sourceLocator ?locator }
}
